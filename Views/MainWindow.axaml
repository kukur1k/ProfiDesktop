<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ProfiDesktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:ProfiDesktop.Views"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
        x:Class="ProfiDesktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="ProfiDesktop">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Window.DataTemplates>
        <DataTemplate DataType="vm:LoginViewModel">
            <views:LoginView/>
        </DataTemplate>
        <DataTemplate DataType="vm:DashBoardViewModel">
            <views:LoginView/>
        </DataTemplate>
    </Window.DataTemplates>

    <Panel>
        <!-- Логин на весь экран-->
        <!--<ContentControl Content="{Binding CurrentPage}"
                        IsVisible="{Binding IsLoginPage}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"/>-->

        
        <Grid RowDefinitions="Auto,*">
            <!--IsVisible="{Binding !IsLoginPage}">-->

            <Border Grid.Row="0"
                Background="#e8e6f0"
                BorderThickness="0 0 0 1"
                BorderBrush="#5d5b68"
                Padding="10 5">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <StackPanel Orientation="Horizontal" Grid.Column="0">
                        <Button Content="X"></Button>  
                        <TextBlock Text="ИТ-Проф"
                            VerticalAlignment="Center"
                            Margin="10 0 0 0"
                            FontSize="15"
                            FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Grid.Column="2" Spacing="10">
                        <Image Source="avares://ProfiDesktop/Assets/avalonia-logo.ico"
                            Width="40" Height="40"/>
                        <TextBlock Text="{Binding UserName}" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding UserRole, StringFormat='({0})'}" FontSize="13" Foreground="#5d5b68" VerticalAlignment="Center"/>
                        <Button Content="▼" Height="30" Width="32" Margin="0 0 10 0">
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuItem Header="Мой профиль" Command=""/>
                                    <MenuItem Header="Настройки" Command=""/>
                                    <MenuItem Header="Выход" Command=""/>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>

                </Grid>
            </Border>
            
        </Grid>

    </Panel>


</Window>
