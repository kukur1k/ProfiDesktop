<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:vm="using:ProfiDesktop.ViewModels"
             x:DataType="vm:ChoiceSlViewModel"
             x:Class="ProfiDesktop.Views.ChoiceSlView">
  
  <Design.DataContext>
    <vm:ChoiceSlViewModel/>  
  </Design.DataContext>

    
    <Border Background="White"
            CornerRadius="8"
            Padding="20"
            MinWidth="400"
            MinHeight="250">

        <StackPanel Spacing="10">
            <TextBlock Text="➕ Добавить в подборку"
                       FontSize="18"
                       FontWeight="Bold"/>

            <TextBlock Text="{Binding ErrorText}"
                       Foreground="Red"
                       IsVisible="{Binding HasError}"
                       TextWrapping="Wrap"/>
            <ProgressBar IsIndeterminate="{Binding IsLoading}"
                         IsVisible="{Binding IsLoading}"
                         Height="4"/>
            <ComboBox ItemsSource="{Binding Shortlists}"
                      SelectedItem="{Binding SelectedShortlist}"
                      DisplayMemberBinding="{Binding Name}"
                      PlaceholderText="Выберите подборку"
                      IsEnabled="{Binding !IsLoading}"
                      HorizontalAlignment="Stretch"/>
            <TextBox Text="{Binding NoteStr}" Margin="0,5,0,0"/>
            <Grid ColumnDefinitions="*,*" Margin="0,10,0,0">
                <Button Grid.Column="0"
                        Content="Отмена"
                        Command="{Binding CancelCommand}"
                        Margin="0,0,5,0"
                        HorizontalAlignment="Stretch"/>

                <Button Grid.Column="1"
                        Content="Добавить"
                        Command="{Binding AddToShortlistCommand}"
                        Classes="accent"
                        Margin="5,0,0,0"
                        HorizontalAlignment="Stretch"/>
            </Grid>

        </StackPanel>
    </Border>




</UserControl>
