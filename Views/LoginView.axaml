<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ProfiDesktop.ViewModels"
             x:Class="ProfiDesktop.Views.LoginView"
             x:DataType="vm:LoginViewModel">


    <Grid RowDefinitions="Auto,Auto,Auto">
        <StackPanel Grid.Row="0"
                    HorizontalAlignment="Center"
                    Margin="0 40 0 30">
            <TextBlock Text="ИТ-Проф" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Text="Личный кабинет HR" FontSize="13" HorizontalAlignment="Center" Margin="0 5 0 0"/>
        </StackPanel>

        <Border Grid.Row="1"
            Margin="10 0"
            Width="420"
            HorizontalAlignment="Center"
            BorderBrush="#3f0fec"
            BorderThickness="1"
            Padding="40 20"
            CornerRadius="10">

            <StackPanel >
                <Grid ColumnDefinitions="80,280">
                    <TextBlock Grid.Column="0" Text="Email:" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding Email}" Watermark="ivanov@example.ru"/>
                </Grid>

                <Grid ColumnDefinitions="80,280" Margin="0 10">
                    <TextBlock Grid.Column="0" Text="Password:" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding Password}" PasswordChar="*"/>
                </Grid>

                <TextBlock Text="{Binding ErrorText}"
                    Foreground="Red"
                    FontSize="13"
                    IsVisible="{Binding HasError}"/>

                <StackPanel Orientation="Horizontal"
                Spacing="10"
                HorizontalAlignment="Center">
                    <Button Content="Войти"
                        Command="{Binding LoginCommand}"
                        Width="120"
                        Height="30"/>
                    <Button Content="Отмена"
                        Command="{Binding CancelCommand}"
                        Width="120"
                        Height="30"/>
                </StackPanel>

                <CheckBox Content="Запомнить меня" IsChecked="{Binding RememberMe}" />
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2" Text="Версия 1.0.0"
            HorizontalAlignment="Center"
            Margin="0 20"
            FontSize="13"/>
    </Grid>

</UserControl>