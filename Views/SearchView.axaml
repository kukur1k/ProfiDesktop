<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ProfiDesktop.ViewModels"
             xmlns:dg="using:Avalonia.Controls"
             x:Class="ProfiDesktop.Views.SearchView"
             x:DataType="vm:SearchViewModel">

    <Design.DataContext>
        <vm:SearchViewModel />
    </Design.DataContext>

    <StackPanel Margin="20">
        <TextBlock Text="🔍 Поиск кандидатов"
                    FontSize="22" 
                    FontWeight="Bold"
                    Margin="0 10"/>
        <!-- Строка поиска -->
        <Grid ColumnDefinitions="*,*">
            <StackPanel Grid.Column="0">
                <TextBox Text="{Binding SuggestQuery}"
                    PlaceholderText="Введите технологию..."
                    Width="200"
                    HorizontalAlignment="Left"
                    Margin="0 0 0 20"/>
                
                <Border Background="White"
                    BorderThickness="1"
                    BorderBrush="#DDD"
                    IsVisible="{Binding ShowSuggest}"
                    HorizontalAlignment="Left">
                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding Suggestions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding StringFormat='➕ {0}'}"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        HorizontalAlignment="Center"
                                        Click="OnSuggestionClick"
                                        Tag="{Binding}"/>
                                </DataTemplate>    
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="120,Auto,120,Auto">
                    <!-- рейтинг -->
                    <TextBlock Text="Мин. рейтинг:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0 5 0 0"/>
                    <TextBox Text="{Binding MinRating}" Grid.Row="0" Grid.Column="1" 
                            Width="50" TextAlignment="Center" VerticalAlignment="Center" Margin="0 5 0 0"/>

                    <!-- Опыт -->
                    <TextBlock Text="Мин. опыт:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0 5 0 0"/>
                    <TextBox Text="{Binding MinExp}" Grid.Row="1" Grid.Column="1" 
                            Width="50" TextAlignment="Center" VerticalAlignment="Center" Margin="0 5 0 0"/>

                    <!-- Уровни -->
                    <TextBlock Text="Мин. уровень:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0 5 0 0"/>
                    <TextBox Text="{Binding MinLevel}" Grid.Row="2" Grid.Column="1" 
                            Width="50" TextAlignment="Center" VerticalAlignment="Center" Margin="0 5 0 0"/>

                    <TextBlock Text="Макс. уровень:" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" Margin="5 5 0 0"/>
                    <TextBox Text="{Binding MaxLevel}" Grid.Row="2" Grid.Column="3" 
                            Width="50" TextAlignment="Center" VerticalAlignment="Center" Margin="0 5 0 0"/>
                </Grid>

                

            </StackPanel>
            

            <!-- Чипы -->
            <StackPanel Grid.Column="1">
                <TextBlock Text="Технологии:" FontSize="20" Margin="0 0 0 10" FontWeight="SemiBold"/> 
                <ItemsControl ItemsSource="{Binding Technology, Converter={StaticResource StrToListConverter}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>    
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="Transparent"
                                Background="#ead4ed"
                                CornerRadius="20"
                                Padding="4 4"
                                Margin="5 3"
                                HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding}"
                                        Foreground="White"
                                        VerticalAlignment="Center"
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Margin="3 0 0 0"/>
                                    <Button Content="❌" VerticalAlignment="Center"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        Click="OnRemoveChipClick"
                                        Cursor="Hand"
                                        Tag="{Binding}"/>
                                </StackPanel>
                                
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                
            </StackPanel>

        </Grid>


    </StackPanel>
    
    

        

</UserControl>