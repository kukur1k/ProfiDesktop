<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ProfiDesktop.ViewModels"
             xmlns:dg="using:Avalonia.Controls"
             x:Class="ProfiDesktop.Views.SearchView"
             x:DataType="vm:SearchViewModel">

    <Design.DataContext>
        <vm:SearchViewModel />
    </Design.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16" Spacing="12">
            
            <TextBlock Text="🔍 Поиск специалистов" 
                       FontSize="22" 
                       FontWeight="Bold" />

            <!-- ============================================ -->
            <!-- ФИЛЬТРЫ                                       -->
            <!-- ============================================ -->
            <Border Background="#F5F5F5" 
                    CornerRadius="8" 
                    Padding="12">
                <StackPanel Spacing="8">
                    
                    <!-- Поле ввода + кнопка -->
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0" 
                                 Text="{Binding SuggestQuery}" 
                                 PlaceholderText="Введите технологию..." />
                        <Button Grid.Column="1" 
                                Content="➕" 
                                Command="{Binding SelectTechOnSuggestCommand}"
                                CommandParameter="{Binding SuggestQuery}"
                                Margin="8,0,0,0"
                                Width="40" />
                    </Grid>

                    <!-- Подсказки -->
                    <Border Background="White" 
                            CornerRadius="4"
                            BorderBrush="#DDD"
                            BorderThickness="1"
                            IsVisible="{Binding ShowSuggest}"
                            MaxHeight="150">
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding Suggestions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- ✅ Кнопка с событием Click -->
                                        <Button Content="{Binding}" 
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="8,4"
                                                HorizontalContentAlignment="Left"
                                                Click="OnSuggestionClick" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <!-- Чипы -->
                    <ItemsControl ItemsSource="{Binding Technology, Converter={StaticResource StringToArrayConverter}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#E8F0FE" 
                                        CornerRadius="16" 
                                        Padding="10,6" 
                                        Margin="0,0,8,4">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{Binding}" FontSize="14" />
                                        <!-- ✅ Кнопка с событием Click -->
                                        <Button Content="×" 
                                                Background="Transparent" 
                                                BorderThickness="0"
                                                Padding="0,0,4,0"
                                                Click="OnRemoveChipClick" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Дополнительные фильтры -->
                    <Border Background="#EEE" CornerRadius="4" Padding="8">
                        <StackPanel>
                            <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*,Auto,*,Auto,*,Auto">
                                <TextBlock Grid.Column="0" Text="Уровень:" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Text="{Binding MinLevel}" Width="40" Margin="4,0" />
                                <TextBlock Grid.Column="2" Text="-" VerticalAlignment="Center" />
                                <TextBox Grid.Column="3" Text="{Binding MaxLevel}" Width="40" Margin="4,0" />

                                <TextBlock Grid.Column="4" Text="Рейтинг:" VerticalAlignment="Center" Margin="12,0,0,0" />
                                <TextBox Grid.Column="5" Text="{Binding MinRating}" Width="50" Margin="4,0" />

                                <TextBlock Grid.Column="6" Text="Опыт (дней):" VerticalAlignment="Center" Margin="12,0,0,0" />
                                <TextBox Grid.Column="7" Text="{Binding MinExp}" Width="50" Margin="4,0" />

                                <Button Grid.Column="9" 
                                        Content="🔍 Найти" 
                                        Command="{Binding SearchCommand}" 
                                        Classes="accent"
                                        Margin="12,0,0,0" />
                            </Grid>

                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                                <TextBlock Text="Показывать:" FontSize="12" VerticalAlignment="Center" />
                                <ComboBox ItemsSource="{Binding PageSizes}" 
                                          SelectedItem="{Binding PageSize}"
                                          Width="60" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ============================================ -->
            <!-- РЕЗУЛЬТАТЫ                                   -->
            <!-- ============================================ -->
            <TextBlock Text="{Binding TotalUsersItems.Count, StringFormat='Найдено: {0} пользователей'}" 
                       FontSize="13" 
                       Foreground="#666" />

            <dg:DataGrid ItemsSource="{Binding UsersItems}" 
                         AutoGenerateColumns="False"
                         MinHeight="200">
                <dg:DataGrid.Columns>
                    <dg:DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50" />
                    <dg:DataGridTextColumn Header="Кандидат" Binding="{Binding DisplayName}" Width="150" />
                    <dg:DataGridTextColumn Header="Рейтинг" Binding="{Binding CompetencyIndex}" Width="80" />
                    <dg:DataGridTextColumn Header="Тренд" Binding="{Binding Trend}" Width="60" />
                    
                    <dg:DataGridTemplateColumn Header="Навыки">
                        <dg:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ItemsControl ItemsSource="{Binding Skills}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#E8F0FE" 
                                                    CornerRadius="10" 
                                                    Padding="6,2" 
                                                    Margin="2">
                                                <TextBlock Text="{Binding}" FontSize="11" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </dg:DataGridTemplateColumn.CellTemplate>
                    </dg:DataGridTemplateColumn>
                </dg:DataGrid.Columns>
            </dg:DataGrid>

            <TextBlock Text="Загрузка..."
                       FontSize="13" 
                       Foreground="#888"
                       HorizontalAlignment="Center"
                       IsVisible="{Binding !UsersItems.Count}" />

        </StackPanel>
    </ScrollViewer>
</UserControl>